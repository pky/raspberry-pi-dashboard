{
  "backup": {
    "enabled": true,
    "compression": true,
    "encryption": false,
    "verification": true
  },
  "local_backup": {
    "base_directory": "/opt/raspberry-pi-backups",
    "max_backups": 10,
    "retention_days": 7,
    "full_retention_days": 7,
    "incremental_retention_days": 7,
    "use_hardlinks": true,
    "rsync_options": [
      "--archive",
      "--verbose",
      "--delete"
    ]
  },
  "source": {
    "home_directory": "~/projects/raspberry-pi-dashboard",
    "system_configs": [
      "/etc/systemd/system/raspberry-pi-*.service",
      "/etc/logrotate.d/raspberry-pi-dashboard"
    ],
    "exclude_patterns": [
      ".cache/",
      ".dbus/",
      ".bash_history",
      ".python_history",
      "*.log",
      "__pycache__/",
      "*.pyc",
      "backups/",
      "backup_*",
      "venv/",
      "logs/",
      ".git/",
      "*.tmp"
    ]
  },
  "scheduling": {
    "daily": {
      "enabled": true,
      "time": "04:00",
      "type": "incremental"
    },
    "weekly": {
      "enabled": false,
      "day": "sunday",
      "time": "05:00",
      "type": "full"
    }
  },
  "notifications": {
    "success": {
      "enabled": true,
      "method": "log"
    },
    "failure": {
      "enabled": true,
      "method": "log",
      "critical": true
    }
  },
  "system": {
    "lock_file": "/tmp/raspberry-pi-backup.lock",
    "log_level": "INFO",
    "max_parallel_operations": 1,
    "timeout_minutes": 60
  }
}
