# OpenWeatherMap Weather API Configuration
# Copy this file to weather.conf and add your API key

[openweather]
# OpenWeatherMap API Key (get from https://openweathermap.org/api)
api_key = YOUR_API_KEY_HERE

[location]
# Location settings for weather data
name = 渋谷区鶯谷町
latitude = 35.652875
longitude = 139.701595

[cache]
# Cache settings (in seconds)
cache_duration = 1680  # 28 minutes

[security]
# Security settings
log_api_key = false  # Never log API key for security