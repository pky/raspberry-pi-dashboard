#!/bin/bash
# コミット前に .py ファイルの構文チェックと静的解析を実行する

STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.py$')
[ -z "$STAGED" ] && exit 0

# flake8 が未インストールの場合は中断
if ! command -v flake8 &>/dev/null; then
    echo "ERROR: flake8 が見つかりません。pip install flake8 を実行してください" >&2
    exit 1
fi

# ステージ外の変更を退避してステージ内容だけをチェックする
git stash --quiet --keep-index
trap 'git stash pop --quiet 2>/dev/null' EXIT

echo "=== 構文チェック ==="
while IFS= read -r f; do
    python3 -m py_compile "$f" || { echo "SyntaxError: $f" >&2; exit 1; }
done <<< "$STAGED"
echo "OK"

echo "=== flake8 (未定義名・構文エラー) ==="
while IFS= read -r f; do
    echo "$f"
done <<< "$STAGED" | xargs flake8 --select=F --max-line-length=120 || exit 1
echo "OK"
